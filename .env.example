NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_ACCESS_TOKEN=

# 브라우저용 네이버 지도 Client ID. Client Secret은 브라우저 빌드에 넣지 않는다.
NEXT_PUBLIC_NCP_MAPS_CLIENT_ID=your_naver_maps_client_id
NCP_MAPS_CLIENT_SECRET=your_server_only_naver_maps_client_secret

# 공공데이터포털 일반 인증키(두 LH API에 공통 사용, Decoding 키 입력)
PUBLIC_SERVICE_KEY=your_data_go_kr_service_key
# 기본값을 쓰지 않고 활용신청 화면의 요청 주소를 지정해야 할 때만 설정
LH_ANNOUNCEMENT_API_URL=https://apis.data.go.kr/B552555/lhLeaseNoticeInfo1/lhLeaseNoticeInfo1
LH_SUPPLY_API_URL=https://apis.data.go.kr/B552555/lhLeaseNoticeSplInfo1
LH_SUPPLY_DETAIL_API_URL=https://apis.data.go.kr/B552555/lhLeaseNoticeDtlInfo1

# 선택값: 미설정 시 HUG 든든전세 공식 공공데이터(15139525) 명세 주소 사용
HUG_LISTINGS_API_URL=https://infuser.odcloud.kr/oas/docs?namespace=15139525/v1

# 선택값: 미설정 시 SH 공식 공고 RSS 사용
SH_ANNOUNCEMENT_RSS_URL=https://www.i-sh.co.kr/main/lay2/program/S1T294C295/www/rss/rssNoticeWrite.do
